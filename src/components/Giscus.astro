---
import config from '@/site-config'

const className = (Astro.props as { class?: string }).class || ''
const giscus = ((config as any).integ?.giscus || {}) as Record<string, string>
---

<div class={className}>
  <script
    src="https://giscus.app/client.js"
    data-repo={String(giscus.repo || '')}
    data-repo-id={String(giscus.repoId || '')}
    data-category={String(giscus.category || '')}
    data-category-id={String(giscus.categoryId || '')}
    data-mapping={String(giscus.mapping || 'pathname')}
    data-strict={String(giscus.strict || '0')}
    data-reactions-enabled={String(giscus.reactionsEnabled || '1')}
    data-emit-metadata={String(giscus.emitMetadata || '0')}
    data-input-position={String(giscus.inputPosition || 'top')}
    data-theme={String(giscus.theme || 'preferred_color_scheme')}
    data-lang={String(giscus.lang || 'zh-CN')}
    data-loading={String(giscus.loading || 'lazy')}
    crossorigin="anonymous"
    async
  />
  <noscript>Giscus requires JavaScript to load.</noscript>
</div>

<script is:inline>
  // Minimal, precise sync: observe <html> class for 'dark'
  const resolveTheme = () => (document.documentElement.classList.contains('dark') ? 'dark' : 'light')

  const postTheme = () => {
    const iframe = document.querySelector('iframe.giscus-frame')
    if (!iframe || !iframe.contentWindow) return
    iframe.contentWindow.postMessage(
      { giscus: { setConfig: { theme: resolveTheme() } } },
      'https://giscus.app'
    )
  }

  // Ensure giscus iframe exists before posting
  const waitAndPost = () => {
    const iframe = document.querySelector('iframe.giscus-frame')
    if (iframe) postTheme()
    else setTimeout(waitAndPost, 200)
  }
  waitAndPost()

  // Observe only class changes on <html>
  const mo = new MutationObserver(postTheme)
  mo.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] })
</script>

